		<script>
function ValidateNo() {
  var phoneNo = document.getElementById('regmobno_id');
  var consumerno = document.getElementById('consumerno_id');
  var formsubmit=true;

  if (consumerno.value == "" || consumerno.value == null) {
    alert("Please enter your Consumer No.");
     document.form1.consumerno.focus();
    return false;
  }  
  if (consumerno.value.length < 13 || consumerno.value.length > 13) {
    alert("Please Enter 13 Digit Consumer No.");
     document.form1.consumerno.focus();
    return false;
  }
  if (phoneNo.value == "" || phoneNo.value == null) {
    alert("Please enter your Mobile No.");
    document.form1.regmobno.focus();
    return false;
  } 
  if (phoneNo.value.length < 10 || phoneNo.value.length > 10) {
    alert("Mobile No. is not valid, Please Enter 10 Digit Mobile No.");
     document.form1.regmobno.focus();
    return false;
  }    
  return true;
 }
 
(function($) {
    $.fn.inputFilter = function(inputFilter) {
      return this.on("input keydown keyup mousedown mouseup select contextmenu drop", function() {
        if (inputFilter(this.value)) {
          this.oldValue = this.value;
          this.oldSelectionStart = this.selectionStart;
          this.oldSelectionEnd = this.selectionEnd;
        } else if (this.hasOwnProperty("oldValue")) {
          this.value = this.oldValue;
          this.setSelectionRange(this.oldSelectionStart, this.oldSelectionEnd);
        } else {
          this.value = "";
        }
      });
    };
  }(jQuery));


  $(document).ready( function () {

    $(".num-5").inputFilter(function(value) {
      return /^[1-9]?\d{0,9}$/.test(value);
    });

    $(".num-13").inputFilter(function(value) {
      return /^[1-9]?\d{0,12}$/.test(value);
    }); 
   });
 </script>
