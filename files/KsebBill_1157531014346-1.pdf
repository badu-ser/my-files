  .tooltip {
    position: relative;
    display: inline-block;
    opacity: 1;
  }

  .tooltip .tooltiptext {
    visibility: hidden;
    width: 170px;
    background-color: #EEF5FB;
    color: #0000FF;
    text-align: center;
    border-radius: 6px;
    padding: 5px 0;
    position: absolute;
    z-index: 1;
    top: 100%;
    left: 85%;
    margin-left: -60px;
    transition: opacity 0.3s;
    border-color: #9797FF;
    border-style: solid;

  }

  .tooltip .tooltiptext::after {
    content: "";
    position: absolute;
    bottom: 70%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: #d1ecf1 transparent transparent transparent;
  }

  .tooltip:hover .tooltiptext {
    visibility: visible;
    opacity: 1;
  }

